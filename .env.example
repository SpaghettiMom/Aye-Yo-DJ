DISCORD_TOKEN=your_discord_bot_token_here
# When running in Docker Compose, set LAVALINK_HOST to the service name: lavalink
# When running locally (not Docker), set it to your Lavalink machine's IP
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token
# Jingle file server — set JINGLE_SERVER_HOST to this machine's LAN IP
# (the address your Lavalink server can reach the bot on)
# In Docker Compose, Lavalink talks to the bot container via Docker network
# so set this to the host machine's LAN IP (e.g. 192.168.1.10)
JINGLE_SERVER_HOST=192.168.1.10
JINGLE_SERVER_PORT=8765
